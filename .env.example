# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tuyendung?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-32-byte-string"

# Anthropic API key for AI-powered CV parsing & JD-candidate matching.
# Optional: if unset, the app falls back to simple keyword-based parsing/matching.
ANTHROPIC_API_KEY=""

# Local file storage directory for uploaded CVs
UPLOAD_DIR="./storage/uploads"

# Seed admin account (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@company.vn"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Quản trị viên"
